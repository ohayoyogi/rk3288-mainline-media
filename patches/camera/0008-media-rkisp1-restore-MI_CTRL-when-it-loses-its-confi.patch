From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ohayoyogi <77435669+ohayoyogi@users.noreply.github.com>
Date: Wed, 21 Oct 2026 11:02:53 +0900
Subject: [PATCH] media: rkisp1: restore MI_CTRL when it loses its
 configuration

On an RK3288 (Tinker Board) with an OV5647, moving the camera cable while
streaming left MI_CTRL at 0x01000000 (its reset value: path enables,
burst lengths, INIT_BASE_EN/INIT_OFFSET_EN and the write format gone)
while the rest of the ISP and the MI size registers were untouched. The
shadow base address then stays on one buffer for good: the hardware
keeps writing that buffer while the driver hands out all of them, so
userspace sees the same old frames in a loop, with no error counted
anywhere.

On SoCs flagged with RKISP1_FEATURE_MI_CTRL_CHECK (only rk3288 for now,
where it was seen) check MI_CTRL at every frame end. If it was reset, return the frame as
VB2_BUF_STATE_ERROR, program the path again, point the shadow registers
at buf.curr with a soft update and keep buf.next in the init registers.
Count it in debugfs (mi_ctrl_restored).

Tested by writing 0x01000000 to MI_CTRL from userspace while streaming:
restored within a frame, no stale frames afterwards.
---
 .../platform/rockchip/rkisp1/rkisp1-capture.c | 81 ++++++++++++++++---
 .../platform/rockchip/rkisp1/rkisp1-common.h  |  5 ++
 .../platform/rockchip/rkisp1/rkisp1-debug.c   |  2 +
 .../platform/rockchip/rkisp1/rkisp1-dev.c     |  3 +-
 4 files changed, 78 insertions(+), 13 deletions(-)

diff --git a/drivers/media/platform/rockchip/rkisp1/rkisp1-capture.c b/drivers/media/platform/rockchip/rkisp1/rkisp1-capture.c
index 486cb73e1..bff68d02d 100644
--- a/drivers/media/platform/rockchip/rkisp1/rkisp1-capture.c
+++ b/drivers/media/platform/rockchip/rkisp1/rkisp1-capture.c
@@ -733,20 +733,14 @@ static void rkisp1_dummy_buf_destroy(struct rkisp1_capture *cap)
 		       cap->buf.dummy.dma_addr, DMA_ATTR_NO_KERNEL_MAPPING);
 }
 
-static void rkisp1_set_next_buf(struct rkisp1_capture *cap)
+/* Program the init (next frame) addresses for buf, or the dummy buffer. */
+static void rkisp1_mi_set_init_addr(struct rkisp1_capture *cap,
+				    struct rkisp1_buffer *buf)
 {
 	u8 shift = rkisp1_has_feature(cap->rkisp1, DMA_34BIT) ? 2 : 0;
 
-	cap->buf.curr = cap->buf.next;
-	cap->buf.next = NULL;
-
-	if (!list_empty(&cap->buf.queue)) {
-		dma_addr_t *buff_addr;
-
-		cap->buf.next = list_first_entry(&cap->buf.queue, struct rkisp1_buffer, queue);
-		list_del(&cap->buf.next->queue);
-
-		buff_addr = cap->buf.next->buff_addr;
+	if (buf) {
+		dma_addr_t *buff_addr = buf->buff_addr;
 
 		rkisp1_write(cap->rkisp1, cap->config->mi.y_base_ad_init,
 			     buff_addr[RKISP1_PLANE_Y] >> shift);
@@ -789,6 +783,57 @@ static void rkisp1_set_next_buf(struct rkisp1_capture *cap)
 	rkisp1_write(cap->rkisp1, cap->config->mi.cr_offs_cnt_init, 0);
 }
 
+static void rkisp1_set_next_buf(struct rkisp1_capture *cap)
+{
+	cap->buf.curr = cap->buf.next;
+	cap->buf.next = NULL;
+
+	if (!list_empty(&cap->buf.queue)) {
+		cap->buf.next = list_first_entry(&cap->buf.queue, struct rkisp1_buffer, queue);
+		list_del(&cap->buf.next->queue);
+	}
+	rkisp1_mi_set_init_addr(cap, cap->buf.next);
+}
+
+/*
+ * MI_CTRL can lose its configuration while streaming: on an RK3288 with an
+ * OV5647 whose cable was being moved it read back 0x01000000 (enables,
+ * burst lengths and INIT_BASE_EN gone) while the rest of the ISP kept
+ * running. The shadow address then never advances: one buffer is written
+ * forever and the others are returned with stale content, for as long as
+ * the stream runs.
+ */
+static bool rkisp1_mi_ctrl_lost(struct rkisp1_capture *cap)
+{
+	u32 mi_ctrl = rkisp1_read(cap->rkisp1, RKISP1_CIF_MI_CTRL);
+	u32 enable = cap->id == RKISP1_MAINPATH
+		   ? RKISP1_CIF_MI_CTRL_MP_ENABLE | RKISP1_CIF_MI_CTRL_RAW_ENABLE
+		   : RKISP1_CIF_MI_CTRL_SP_ENABLE;
+
+	return !(mi_ctrl & RKISP1_CIF_MI_CTRL_INIT_BASE_EN) || !(mi_ctrl & enable);
+}
+
+/*
+ * Program the path again and point the shadow registers at the buffer the
+ * driver now expects to be written (buf.curr); buf.next stays in the init
+ * registers for the next frame end.
+ */
+static void rkisp1_mi_restore(struct rkisp1_capture *cap)
+{
+	struct rkisp1_device *rkisp1 = cap->rkisp1;
+	u32 reg = 0;
+
+	cap->ops->config(cap);
+	cap->ops->enable(cap);
+
+	rkisp1_mi_set_init_addr(cap, cap->buf.curr);
+	if (rkisp1_has_feature(rkisp1, MAIN_STRIDE))
+		reg = rkisp1_read(rkisp1, RKISP1_CIF_MI_INIT) &
+		      RKISP1_CIF_MI_INIT_MP_OUTPUT_MASK;
+	rkisp1_write(rkisp1, RKISP1_CIF_MI_INIT, reg | RKISP1_CIF_MI_INIT_SOFT_UPD);
+	rkisp1_mi_set_init_addr(cap, cap->buf.next);
+}
+
 /*
  * This function is called when a frame end comes. The next frame
  * is processing and we should set up buffer for next-next frame,
@@ -798,20 +843,32 @@ static void rkisp1_handle_buffer(struct rkisp1_capture *cap)
 {
 	struct rkisp1_isp *isp = &cap->rkisp1->isp;
 	struct rkisp1_buffer *curr_buf;
+	bool lost;
 
 	spin_lock(&cap->buf.lock);
 	curr_buf = cap->buf.curr;
+	lost = rkisp1_has_feature(cap->rkisp1, MI_CTRL_CHECK) &&
+	       rkisp1_mi_ctrl_lost(cap);
 
 	if (curr_buf) {
 		curr_buf->vb.sequence = isp->frame_sequence;
 		curr_buf->vb.vb2_buf.timestamp = ktime_get_boottime_ns();
 		curr_buf->vb.field = V4L2_FIELD_NONE;
-		vb2_buffer_done(&curr_buf->vb.vb2_buf, VB2_BUF_STATE_DONE);
+		/* with MI_CTRL lost this buffer was not written */
+		vb2_buffer_done(&curr_buf->vb.vb2_buf,
+				lost ? VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE);
 	} else {
 		cap->rkisp1->debug.frame_drop[cap->id]++;
 	}
 
 	rkisp1_set_next_buf(cap);
+	if (lost) {
+		rkisp1_mi_restore(cap);
+		cap->rkisp1->debug.mi_ctrl_restored++;
+		dev_warn_ratelimited(cap->rkisp1->dev,
+				     "%s: MI_CTRL lost its configuration, restored\n",
+				     cap->vnode.vdev.name);
+	}
 	spin_unlock(&cap->buf.lock);
 }
 
diff --git a/drivers/media/platform/rockchip/rkisp1/rkisp1-common.h b/drivers/media/platform/rockchip/rkisp1/rkisp1-common.h
index 88b407f2f..b775366fa 100644
--- a/drivers/media/platform/rockchip/rkisp1/rkisp1-common.h
+++ b/drivers/media/platform/rockchip/rkisp1/rkisp1-common.h
@@ -121,6 +121,8 @@ enum rkisp1_isp_pad {
  * @RKISP1_FEATURE_COMPAND: The ISP has a companding block
  * @RKISP1_FEATURE_CHROM_BURST_32: 64-beat chroma write bursts corrupt the
  *	chroma plane, use 32-beat bursts
+ * @RKISP1_FEATURE_MI_CTRL_CHECK: MI_CTRL has been seen to fall back to its
+ *	reset value while streaming; check and restore it at every frame end
  *
  * The ISP features are stored in a bitmask in &rkisp1_info.features and allow
  * the driver to implement support for features present in some ISP versions
@@ -135,6 +137,7 @@ enum rkisp1_feature {
 	RKISP1_FEATURE_BLS = BIT(5),
 	RKISP1_FEATURE_COMPAND = BIT(6),
 	RKISP1_FEATURE_CHROM_BURST_32 = BIT(7),
+	RKISP1_FEATURE_MI_CTRL_CHECK = BIT(8),
 };
 
 #define rkisp1_has_feature(rkisp1, feature) \
@@ -486,6 +489,7 @@ struct rkisp1_resizer {
  * @img_stabilization_size_error: size error is generated in image stabilization submodule
  * @inform_size_err:		  size error is generated in inform submodule
  * @mipi_error:			  mipi error occurred
+ * @mi_ctrl_restored: MI_CTRL found reset while streaming and restored
  * @stats_error:		  writing to the 'Interrupt clear register' did not clear
  *				  it in the register 'Masked interrupt status'
  * @stop_timeout:		  upon stream stop, the capture waits 1 second for the isr to stop
@@ -502,6 +506,7 @@ struct rkisp1_debug {
 	unsigned long irq_delay;
 	unsigned long mipi_error;
 	unsigned long stats_error;
+	unsigned long mi_ctrl_restored;
 	unsigned long stop_timeout[2];
 	unsigned long frame_drop[2];
 	unsigned long complete_frames;
diff --git a/drivers/media/platform/rockchip/rkisp1/rkisp1-debug.c b/drivers/media/platform/rockchip/rkisp1/rkisp1-debug.c
index 79cda589d..812d952a9 100644
--- a/drivers/media/platform/rockchip/rkisp1/rkisp1-debug.c
+++ b/drivers/media/platform/rockchip/rkisp1/rkisp1-debug.c
@@ -213,6 +213,8 @@ void rkisp1_debug_init(struct rkisp1_device *rkisp1)
 			     &debug->mipi_error);
 	debugfs_create_ulong("stats_error", 0444, debug->debugfs_dir,
 			     &debug->stats_error);
+	debugfs_create_ulong("mi_ctrl_restored", 0444, debug->debugfs_dir,
+			     &debug->mi_ctrl_restored);
 	debugfs_create_ulong("mp_stop_timeout", 0444, debug->debugfs_dir,
 			     &debug->stop_timeout[RKISP1_MAINPATH]);
 	debugfs_create_ulong("sp_stop_timeout", 0444, debug->debugfs_dir,
diff --git a/drivers/media/platform/rockchip/rkisp1/rkisp1-dev.c b/drivers/media/platform/rockchip/rkisp1/rkisp1-dev.c
index 2d552013a..a38d22200 100644
--- a/drivers/media/platform/rockchip/rkisp1/rkisp1-dev.c
+++ b/drivers/media/platform/rockchip/rkisp1/rkisp1-dev.c
@@ -533,7 +533,8 @@ static const struct rkisp1_info rk3288_isp_info = {
 		  | RKISP1_FEATURE_SELF_PATH
 		  | RKISP1_FEATURE_DUAL_CROP
 		  | RKISP1_FEATURE_BLS
-		  | RKISP1_FEATURE_CHROM_BURST_32,
+		  | RKISP1_FEATURE_CHROM_BURST_32
+		  | RKISP1_FEATURE_MI_CTRL_CHECK,
 	.max_width = 4416,
 	.max_height = 3312,
 };
-- 
