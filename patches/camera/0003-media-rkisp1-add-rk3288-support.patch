From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ohayoyogi <77435669+ohayoyogi@users.noreply.github.com>
Date: Wed, 21 Oct 2026 02:38:18 +0900
Subject: [PATCH] media: rkisp1: add rk3288 support

The RK3288 ISP is the same V10 block as RK3399's, with a shared
interrupt, and also needs the camera input pixel clock and the JPE
clock running.

The first three clocks come from the common name table; pclk_in and jpe
are RK3288-only and are requested by name after them.

Based on the 2020 RFC by Karthik Poduval (clock list and compatible).

Link: https://patchwork.kernel.org/project/linux-media/list/?series=266737
---
 .../platform/rockchip/rkisp1/rkisp1-common.h  |  6 ++-
 .../platform/rockchip/rkisp1/rkisp1-dev.c     | 44 ++++++++++++++++++-
 2 files changed, 48 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/rockchip/rkisp1/rkisp1-common.h b/drivers/media/platform/rockchip/rkisp1/rkisp1-common.h
index 6028ecdd2..f4a65e537 100644
--- a/drivers/media/platform/rockchip/rkisp1/rkisp1-common.h
+++ b/drivers/media/platform/rockchip/rkisp1/rkisp1-common.h
@@ -56,7 +56,7 @@ struct regmap;
 #define RKISP1_BUS_INFO				"platform:" RKISP1_DRIVER_NAME
 
 /* maximum number of clocks */
-#define RKISP1_MAX_BUS_CLK			4
+#define RKISP1_MAX_BUS_CLK			5
 
 /* a bitmask of the ready stats */
 #define RKISP1_STATS_MEAS_MASK			(RKISP1_CIF_ISP_AWB_DONE |	\
@@ -141,6 +141,8 @@ enum rkisp1_feature {
  * struct rkisp1_info - Model-specific ISP Information
  *
  * @num_clocks: number of clocks
+ * @extra_clks: names of further clocks, after the first @num_clocks
+ * @num_extra_clks: number of entries in the @extra_clks array
  * @isrs: array of ISP interrupt descriptors
  * @isr_size: number of entries in the @isrs array
  * @isp_ver: ISP version
@@ -155,6 +157,8 @@ enum rkisp1_feature {
  */
 struct rkisp1_info {
 	unsigned int num_clocks;
+	const char * const *extra_clks;
+	unsigned int num_extra_clks;
 	const struct rkisp1_isr_data *isrs;
 	unsigned int isr_size;
 	enum rkisp1_cif_isp_version isp_ver;
diff --git a/drivers/media/platform/rockchip/rkisp1/rkisp1-dev.c b/drivers/media/platform/rockchip/rkisp1/rkisp1-dev.c
index 1791c02a4..f55d9cab1 100644
--- a/drivers/media/platform/rockchip/rkisp1/rkisp1-dev.c
+++ b/drivers/media/platform/rockchip/rkisp1/rkisp1-dev.c
@@ -512,6 +512,31 @@ static const struct rkisp1_info px30_isp_info = {
 	.max_height = 2448,
 };
 
+static const char * const rk3288_isp_extra_clks[] = {
+	"pclk_in",
+	"jpe",
+};
+
+static const struct rkisp1_isr_data rk3288_isp_isrs[] = {
+	{ NULL, rkisp1_isr, BIT(RKISP1_IRQ_ISP) | BIT(RKISP1_IRQ_MI) | BIT(RKISP1_IRQ_MIPI) },
+};
+
+/* rk3288 has the same V10 ISP as rk3399, with one more clock pair */
+static const struct rkisp1_info rk3288_isp_info = {
+	.num_clocks = 3,
+	.extra_clks = rk3288_isp_extra_clks,
+	.num_extra_clks = ARRAY_SIZE(rk3288_isp_extra_clks),
+	.isrs = rk3288_isp_isrs,
+	.isr_size = ARRAY_SIZE(rk3288_isp_isrs),
+	.isp_ver = RKISP1_V10,
+	.features = RKISP1_FEATURE_MIPI_CSI2
+		  | RKISP1_FEATURE_SELF_PATH
+		  | RKISP1_FEATURE_DUAL_CROP
+		  | RKISP1_FEATURE_BLS,
+	.max_width = 4416,
+	.max_height = 3312,
+};
+
 static const struct rkisp1_isr_data rk3399_isp_isrs[] = {
 	{ NULL, rkisp1_isr, BIT(RKISP1_IRQ_ISP) | BIT(RKISP1_IRQ_MI) | BIT(RKISP1_IRQ_MIPI) },
 };
@@ -559,6 +584,10 @@ static const struct of_device_id rkisp1_of_match[] = {
 		.compatible = "rockchip,px30-cif-isp",
 		.data = &px30_isp_info,
 	},
+	{
+		.compatible = "rockchip,rk3288-cif-isp",
+		.data = &rk3288_isp_info,
+	},
 	{
 		.compatible = "rockchip,rk3399-cif-isp",
 		.data = &rk3399_isp_info,
@@ -584,7 +613,7 @@ static int rkisp1_init_clocks(struct rkisp1_device *rkisp1)
 	unsigned int i;
 	int ret;
 
-	static_assert(ARRAY_SIZE(rkisp1_clk_names) == ARRAY_SIZE(rkisp1->clks));
+	static_assert(ARRAY_SIZE(rkisp1_clk_names) <= ARRAY_SIZE(rkisp1->clks));
 
 	for (i = 0; i < info->num_clocks; i++)
 		rkisp1->clks[i].id = rkisp1_clk_names[i];
@@ -612,6 +641,19 @@ static int rkisp1_init_clocks(struct rkisp1_device *rkisp1)
 			rkisp1->clks[rkisp1->clk_size++].clk = clk;
 	}
 
+	for (i = 0; i < info->num_extra_clks; i++) {
+		struct clk *clk;
+
+		clk = devm_clk_get(rkisp1->dev, info->extra_clks[i]);
+		if (IS_ERR(clk))
+			return dev_err_probe(rkisp1->dev, PTR_ERR(clk),
+					     "Failed to acquire %s clock\n",
+					     info->extra_clks[i]);
+
+		rkisp1->clks[rkisp1->clk_size].id = info->extra_clks[i];
+		rkisp1->clks[rkisp1->clk_size++].clk = clk;
+	}
+
 	return 0;
 }
 
-- 
2.43.0

