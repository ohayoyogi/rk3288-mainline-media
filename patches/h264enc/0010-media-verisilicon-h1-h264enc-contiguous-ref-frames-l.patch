From c080a0b978914202f770dc63d12c20de532e196a Mon Sep 17 00:00:00 2001
From: ohayoyogi <77435669+ohayoyogi@users.noreply.github.com>
Date: Tue, 20 Oct 2026 22:17:21 +0900
Subject: [PATCH 10/14] media: verisilicon: h1 h264enc: contiguous ref frames,
 legacy H1 quirks, ROI outside picture

---
 drivers/media/platform/verisilicon/hantro.h   |  6 +++
 .../platform/verisilicon/hantro_h1_h264_enc.c | 31 ++++++++-----
 .../media/platform/verisilicon/hantro_h264.c  | 43 ++++++++-----------
 .../platform/verisilicon/rockchip_vpu_hw.c    |  3 +-
 4 files changed, 48 insertions(+), 35 deletions(-)

diff --git a/drivers/media/platform/verisilicon/hantro.h b/drivers/media/platform/verisilicon/hantro.h
index 7c43e43d9..9988b8d8a 100644
--- a/drivers/media/platform/verisilicon/hantro.h
+++ b/drivers/media/platform/verisilicon/hantro.h
@@ -104,6 +104,12 @@ struct hantro_variant {
 	unsigned int double_buffer : 1;
 	unsigned int legacy_regs : 1;
 	unsigned int late_postproc : 1;
+	/*
+	 * Older H1 encoder revision (e.g. RK3288 VEPU1): 0x084/0x088 are
+	 * checkpoint registers rather than H.264 long-term reference
+	 * controls, and ENC_CTRL bit 7 (4MB recon write buffer) is absent.
+	 */
+	unsigned int h1_legacy : 1;
 	const struct of_device_id *shared_devices;
 };
 
diff --git a/drivers/media/platform/verisilicon/hantro_h1_h264_enc.c b/drivers/media/platform/verisilicon/hantro_h1_h264_enc.c
index a9f742c73..eaffcb45a 100644
--- a/drivers/media/platform/verisilicon/hantro_h1_h264_enc.c
+++ b/drivers/media/platform/verisilicon/hantro_h1_h264_enc.c
@@ -118,7 +118,7 @@ static void hantro_h1_h264_enc_set_params(struct hantro_dev *vpu, struct hantro_
 	s32 scaler;
 	u32 skip_penalty;
 	u8 dmv_qpel_penalty[128];
-	u32 reg;
+	u32 reg, area;
 	int i;
 
 	reg = H1_REG_ENC_CTRL0_INIT_QP(params->pic_init_qp_minus26 + 26)
@@ -185,9 +185,14 @@ static void hantro_h1_h264_enc_set_params(struct hantro_dev *vpu, struct hantro_
 		| H1_REG_QP_VAL_CHECKPOINT_DISTAN(0);
 	vepu_write_relaxed(vpu, reg, H1_REG_QP_VAL);
 
-	/* Don't use ROI */
-	vepu_write_relaxed(vpu, 0, H1_REG_FIRST_ROI_AREA);
-	vepu_write_relaxed(vpu, 0, H1_REG_SECOND_ROI_AREA);
+	/*
+	 * Don't use ROI. An all-zero area is MB (0,0), not "disabled";
+	 * put the areas outside the picture instead, as MPP does.
+	 * Layout: left[31:24] right[23:16] top[15:8] bottom[7:0], in MBs.
+	 */
+	area = (mb_width << 24) | (mb_width << 16) | (mb_height << 8) | mb_height;
+	vepu_write_relaxed(vpu, area, H1_REG_FIRST_ROI_AREA);
+	vepu_write_relaxed(vpu, area, H1_REG_SECOND_ROI_AREA);
 
 	/* Don't use stabilization */
 	vepu_write_relaxed(vpu, 0, H1_REG_STABILIZATION_OUTPUT);
@@ -217,8 +222,8 @@ static void hantro_h1_h264_enc_set_params(struct hantro_dev *vpu, struct hantro_
 	/* Disable CIR */
 	vepu_write_relaxed(vpu, 0, H1_REG_CIR_INTRA_CTRL);
 
-	/* Disable intra area */
-	vepu_write_relaxed(vpu, 0, H1_REG_INTRA_AREA_CTRL);
+	/* Disable intra area (outside the picture, same layout as ROI) */
+	vepu_write_relaxed(vpu, area, H1_REG_INTRA_AREA_CTRL);
 
 	reg = H1_REG_ZERO_MV_FAVOR_D2(ZERO_16x16_MV_FAVOR_DIV2)
 		| H1_REG_PENALTY_4X4MV(0);
@@ -306,7 +311,9 @@ static void hantro_h1_h264_enc_set_buffers(struct hantro_dev *vpu, struct hantro
 	/* reference buffers */
 	if (params->slice_type) {
 		/* intra */
-		if (params->flags & V4L2_H264_ENCODE_FLAG_MARK_LONGTERM) {
+		/* older H1 (RK3288) has no long-term reference support */
+		if ((params->flags & V4L2_H264_ENCODE_FLAG_MARK_LONGTERM) &&
+		    !vpu->variant->h1_legacy) {
 			ctx->h264_enc.ltr_idx = ctx->h264_enc.reconstr_idx;
 			vepu_write_relaxed(vpu, H1_REG_H264_MARK_LONGTRERM,
 					   H1_REG_H264_REFERENCE_CTRL);
@@ -315,9 +322,12 @@ static void hantro_h1_h264_enc_set_buffers(struct hantro_dev *vpu, struct hantro
 		/* inter */
 		if (params->reference_ts == ctx->h264_enc.reference_ts[ctx->h264_enc.last_idx]) {
 			i = ctx->h264_enc.last_idx;
-			vepu_write_relaxed(vpu, H1_REG_H264_MV_REF_IDX(0),
-					   H1_REG_H264_REFERENCE_IDX);
+			/* 0x084 is a checkpoint register on older H1 */
+			if (!vpu->variant->h1_legacy)
+				vepu_write_relaxed(vpu, H1_REG_H264_MV_REF_IDX(0),
+						   H1_REG_H264_REFERENCE_IDX);
 		} else {
+			/* never reached on h1_legacy: no ltr_idx, rejected in validate */
 			i = ctx->h264_enc.ltr_idx;
 			vepu_write_relaxed(vpu, H1_REG_H264_MV_REF_IDX(1),
 					   H1_REG_H264_REFERENCE_IDX);
@@ -444,9 +454,10 @@ int hantro_h1_h264_enc_run(struct hantro_ctx *ctx)
 		| H1_REG_ENC_CTRL_NAL_MODE_BIT
 		| H1_REG_ENC_CTRL_WIDTH(MB_WIDTH(ctx->src_fmt.width))
 		| H1_REG_ENC_CTRL_HEIGHT(MB_HEIGHT(ctx->src_fmt.height))
-		| H1_REG_ENC_REC_WRITE_BUFFER_4MB
 		| H1_REG_ENC_CTRL_ENC_MODE_H264
 		| H1_REG_ENC_CTRL_EN_BIT;
+	if (!vpu->variant->h1_legacy)
+		reg |= H1_REG_ENC_REC_WRITE_BUFFER_4MB;
 	if (params->slice_type) {
 		struct vb2_v4l2_buffer *dst_buf;
 
diff --git a/drivers/media/platform/verisilicon/hantro_h264.c b/drivers/media/platform/verisilicon/hantro_h264.c
index 9bd064611..ecee5635e 100644
--- a/drivers/media/platform/verisilicon/hantro_h264.c
+++ b/drivers/media/platform/verisilicon/hantro_h264.c
@@ -1123,11 +1123,7 @@ void hantro_h264_enc_exit(struct hantro_ctx *ctx)
 			  ctx->h264_enc.nal_table.cpu,
 			  ctx->h264_enc.nal_table.dma);
 
-	i = HANTRO_H264_NUM_INTERNAL_FRAMES;
-	while (--i >= 0)
-		dma_free_coherent(vpu->dev, ctx->h264_enc.chroma_internal[i].size,
-				  ctx->h264_enc.chroma_internal[i].cpu,
-				  ctx->h264_enc.chroma_internal[i].dma);
+	/* chroma_internal[] lives inside luma_internal[], see init */
 	i = HANTRO_H264_NUM_INTERNAL_FRAMES;
 	while (--i >= 0)
 		dma_free_coherent(vpu->dev, ctx->h264_enc.luma_internal[i].size,
@@ -1199,26 +1195,31 @@ int hantro_h264_enc_init(struct hantro_ctx *ctx)
 	mb_height = DIV_ROUND_UP(ctx->src_fmt.height, 16);
 	mb_total = mb_width * mb_height;
 
+	/*
+	 * Reconstructed/reference frames: luma immediately followed by
+	 * chroma in a single buffer, plus one MB row of slack, as Rockchip's
+	 * MPP does. The H1 motion search reads past the end of the reference
+	 * luma plane (seen on RK3288: two 128-byte bursts right after it);
+	 * with separately allocated planes that read hits an unmapped IOVA
+	 * and the IOMMU faults forever. chroma_internal[] only points into
+	 * the luma_internal[] allocation and is never freed on its own.
+	 */
 	for (i = 0; i < HANTRO_H264_NUM_INTERNAL_FRAMES; ++i) {
+		size_t luma = mb_total * LUMA_MB_BYTES;
+		size_t chroma = N_CHROMA_PLANES * mb_total * CHROMA_MB_BYTES;
+
 		aux_buf = &ctx->h264_enc.luma_internal[i];
-		aux_buf->size = mb_total * LUMA_MB_BYTES;
+		aux_buf->size = luma + chroma + mb_width * LUMA_MB_BYTES;
 		aux_buf->cpu = dma_alloc_coherent(vpu->dev, aux_buf->size,
 						  &aux_buf->dma, GFP_KERNEL);
 		if (!aux_buf->cpu) {
 			ret = -ENOMEM;
 			goto err_free_luma_internal;
 		}
-	}
 
-	for (i = 0; i < HANTRO_H264_NUM_INTERNAL_FRAMES; ++i) {
-		aux_buf = &ctx->h264_enc.chroma_internal[i];
-		aux_buf->size = N_CHROMA_PLANES * mb_total * CHROMA_MB_BYTES;
-		aux_buf->cpu = dma_alloc_coherent(vpu->dev, aux_buf->size,
-						  &aux_buf->dma, GFP_KERNEL);
-		if (!aux_buf->cpu) {
-			ret = -ENOMEM;
-			goto err_free_chroma_internal;
-		}
+		ctx->h264_enc.chroma_internal[i].cpu = aux_buf->cpu + luma;
+		ctx->h264_enc.chroma_internal[i].dma = aux_buf->dma + luma;
+		ctx->h264_enc.chroma_internal[i].size = chroma;
 	}
 
 	aux_buf = &ctx->h264_enc.nal_table;
@@ -1227,7 +1228,8 @@ int hantro_h264_enc_init(struct hantro_ctx *ctx)
 					  &aux_buf->dma, GFP_KERNEL);
 	if (!aux_buf->cpu) {
 		ret = -ENOMEM;
-		goto err_free_chroma_internal;
+		i = HANTRO_H264_NUM_INTERNAL_FRAMES;
+		goto err_free_luma_internal;
 	}
 
 	for (i = 0; i < HANTRO_H264_CABAC_IDC_NUM; ++i) {
@@ -1281,13 +1283,6 @@ int hantro_h264_enc_init(struct hantro_ctx *ctx)
 			  ctx->h264_enc.nal_table.dma);
 	i = HANTRO_H264_NUM_INTERNAL_FRAMES;
 
-err_free_chroma_internal:
-	while (--i >= 0)
-		dma_free_coherent(vpu->dev, ctx->h264_enc.chroma_internal[i].size,
-				  ctx->h264_enc.chroma_internal[i].cpu,
-				  ctx->h264_enc.chroma_internal[i].dma);
-	i = HANTRO_H264_NUM_INTERNAL_FRAMES;
-
 err_free_luma_internal:
 	while (--i >= 0)
 		dma_free_coherent(vpu->dev, ctx->h264_enc.luma_internal[i].size,
diff --git a/drivers/media/platform/verisilicon/rockchip_vpu_hw.c b/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
index d6c5e5e85..ca2ba9a31 100644
--- a/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
+++ b/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
@@ -818,7 +818,8 @@ const struct hantro_variant rk3288_vpu_variant = {
 	.num_irqs = ARRAY_SIZE(rockchip_vpu1_irqs),
 	.init = rk3288_vpu_hw_init,
 	.clk_names = rockchip_vpu_clk_names,
-	.num_clocks = ARRAY_SIZE(rockchip_vpu_clk_names)
+	.num_clocks = ARRAY_SIZE(rockchip_vpu_clk_names),
+	.h1_legacy = 1,
 };
 
 /* VDPU2/VEPU2 */
-- 
2.43.0

